<!-- Loaded only where the "Web Browser (JCEF)" plugin exists, 2026.2 and later; the one place which names a class of
     the signin.jcef package, see BrowserSignInGateTest. -->
<idea-plugin>
  <extensions defaultExtensionNs="com.urswolfer.intellij.plugin.gerrit">
    <browserSignIn implementation="com.urswolfer.intellij.plugin.gerrit.signin.jcef.JcefBrowserSignIn"/>
  </extensions>
</idea-plugin>
